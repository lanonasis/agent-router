# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local IDE/agent settings (per-machine, not shared)
.claude/settings.local.json
.cursor/settings.local.json
.windsurf/settings.local.json
.pi

# Service secrets (loaded directly by the onasis-ai-router.service systemd unit
# via `dotenvx run -f services/onasis-ai-router/.env.production` at deploy path)
services/onasis-ai-router/.env.keys
services/onasis-ai-router/.env.production

# Historically leaked to git history (untracked 2026-08-19, keys need rotation
# regardless — see onasis-ai-router security audit) — never re-add these.
services/onasis-ai-router/.env
services/onasis-ai-router/.env.branded

# Router logs (runtime artefacts)
services/onasis-ai-router/logs/

# Local Netlify folder
.netlify

# Local Vercel folder (build output of the Vercel deployment)
.vercel

# ── One package manager: bun ───────────────────────────────────────────────
# bun.lock at the repository root is the ONLY lockfile — it covers every
# workspace. Three things used to drift here and are now excluded so they
# cannot come back:
#   package-lock.json  — npm, a second and divergent dependency graph
#   bun.lockb          — bun's binary lockfile, redundant with bun.lock
#   apps/*/bun.lock     — orphaned; bun writes the ROOT bun.lock even when
#                         run from inside a workspace member
package-lock.json
bun.lockb
**/bun.lock
!/bun.lock
