# ── Primary Vendor: Ollama (local) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_PATH=/api/chat
OLLAMA_MODEL=coda
OLLAMA_CODA_MODEL=qwen2.5-coder-ops:latest
OLLAMA_TOOL_MODEL=qwen2:1.5b
OLLAMA_GENERAL_MODEL=qwen2.5-coder:3b
OLLAMA_LANA_MODEL=
OLLAMA_MIRA_MODEL=
# Optional: separate fast/quality models (falls back to OLLAMA_MODEL)
OLLAMA_FAST_MODEL=
OLLAMA_QUALITY_MODEL=

# Prompt identity handling:
# - hybrid: inject SOUL.md + role prompt + runtime prompt
# - embedded: trust Ollama model SYSTEM prompt, but still inject rich identity for cloud fallbacks
# - runtime: only inject the short runtime prompt
PROMPT_IDENTITY_MODE=hybrid
PROMPTS_ROOT=./agent_model_files

# ── Fallback Vendor: Supabase Edge Function ───────────────────────────────────
# Activated automatically if Ollama is unavailable.
# The edge function internally routes to OpenAI / Claude / OpenRouter / Gemini.
SUPABASE_URL=https://mxtsdgkwzjzlttpotole.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_EDGE_CHAT_PATH=/functions/v1/ai-chat
SUPABASE_EDGE_TIMEOUT_MS=30000

# ── External Vendor: DeepSeek API ─────────────────────────────────────────────
# DeepSeek API for high-quality reasoning and multi-round conversations
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_PATH=/chat/completions
DEEPSEEK_TIMEOUT_MS=30000

# ── Gateway Vendor: OpenClaw (active) ─────────────────────────────────────────
# Multi-channel agent gateway, OpenAI-compatible /v1/chat/completions.
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_CHAT_PATH=/v1/chat/completions
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEFAULT_AGENT=fixer
OPENCLAW_TIMEOUT_MS=30000

# ── Gateway Vendor: Hermes (stub — chat path unverified, see adapter header) ──
# Tailscale-only; srv896342's own gateway IP/key — do not share with lanonasis-main.
HERMES_BASE_URL=http://100.107.32.45:8642
HERMES_CHAT_PATH=/v1/chat/completions
API_SERVER_KEY=
API_SERVER_MODEL_NAME=Hermes Agent
HERMES_TIMEOUT_MS=30000

# ── Circuit Breaker ───────────────────────────────────────────────────────────
# After VENDOR_CIRCUIT_THRESHOLD consecutive failures within VENDOR_CIRCUIT_COOLDOWN_MS,
# the vendor is bypassed and the next in the fallback chain is tried directly.
VENDOR_CIRCUIT_THRESHOLD=3
VENDOR_CIRCUIT_COOLDOWN_MS=30000

# ── Fallback-chain timeout ratio ───────────────────────────────────────────────
# Vendors after the first in a use-case's fallback chain get this fraction of
# their own configured {VENDOR}_TIMEOUT_MS, so a degraded fallback path fails
# faster instead of paying every vendor's full timeout in sequence.
VENDOR_FALLBACK_TIMEOUT_RATIO=0.65

# ── Auth-gateway result cache (Redis, optional) ────────────────────────────────
# Caches authenticateRequest's per-credential auth-gateway resolution for
# AUTH_CACHE_TTL_SECONDS, shared across all router replicas. Fails open (skips
# caching, calls the auth-gateway directly) if REDIS_URL is unset or Redis is
# unreachable — this is a pure latency optimisation, never a hard dependency.
# Uses the onasis-maas Redis Cloud instance shared with sibling services.
REDIS_URL=
AUTH_CACHE_TTL_SECONDS=20

# ── Shared HTTP client (undici keep-alive agent) ───────────────────────────────
# Applies to every outbound fetch() in this process (vendors, memory-prefetch,
# tool calls, auth-gateway) via vendors/_shared/http-client.js.
HTTP_KEEPALIVE_TIMEOUT_MS=30000
HTTP_KEEPALIVE_MAX_TIMEOUT_MS=600000
HTTP_MAX_CONNECTIONS_PER_ORIGIN=20

# ── Split request-lifecycle timeouts ───────────────────────────────────────────
# AUTH_GATEWAY_TIMEOUT_MS and MEMORY_PREFETCH_TIMEOUT_MS used to share
# ROUTER_TIMEOUT_MS (15000ms) — oversized for a same-host auth call and an
# optional prefetch enrichment. ROUTER_TIMEOUT_MS itself now governs only the
# memory.search/get/write tool-call fetches.
AUTH_GATEWAY_TIMEOUT_MS=3000
MEMORY_PREFETCH_TIMEOUT_MS=3000

# ── Inbound keep-alive (this server's own listener) ────────────────────────────
SERVER_KEEPALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000

# ── Session memory proxy (Redis Agent Memory) ───────────────────────────────────
# Real credentials live here, server-side, deliberately — /api/v1/session-memory/*
# routes proxy to Redis Agent Memory so published client packages (e.g.
# @lanonasis/repl-cli) never receive the raw AGENT_MEMORY_API_KEY. See
# core/session-memory-proxy.js. Routes 501 (not 500) when any of these three
# are unset — session memory is an optional add-on, not a hard dependency.
AGENT_MEMORY_URL=
AGENT_MEMORY_STORE_ID=
AGENT_MEMORY_API_KEY=
AGENT_MEMORY_TIMEOUT_MS=5000

# System Prompt
OLLAMA_SYSTEM_PROMPT=You are L0, an AI coding assistant with access to semantic memory. Use memory.search to recall past conversations and stored knowledge. For code tasks, analyze thoroughly before suggesting changes. When unsure, search memory first.

# API Endpoints
API_BASE_URL=https://api.lanonasis.com
AUTH_GATEWAY_URL=http://localhost:4000

# Memory Service Configuration
MEMORY_PREFETCH_ENABLED=true
MEMORY_PREFETCH_TOPK=8
MEMORY_PREFETCH_MAX_CHARS=4000
MEMORY_SEARCH_PATH=/api/v1/memories/search
MEMORY_GET_PATH=/api/v1/memories
MEMORY_WRITE_PATH=/api/v1/memories
MEMORY_BATCH_GET_PATH=/api/v1/memories/batch

# Memory Authentication (for tool calls)
# Use one of these authentication methods:
MEMORY_AUTH_BEARER=
MEMORY_API_KEY=lano_your_api_key_here

# Tool Configuration
TOOL_RESULT_SUMMARIZE=true
TOOL_RESULT_MAX_CHARS=6000
SOFT_TOOL_PARSE=true
RESPONSE_CLEANUP_ENABLED=true
RETURN_ACTIONS_ENVELOPE=false

# Caller-executed tool lane (use_case: tool-proxy).
# Comma-separated UAI auth_ids permitted to use it. UNSET/EMPTY MEANS NOBODY:
# the lane returns model tool_calls for the caller to run, so it is an
# allowlisted capability, not a general one. A refused request logs the
# caller's auth_id so an operator can add it here.
TOOL_PASSTHROUGH_AUTH_IDS=

# Router Settings
ROUTER_TIMEOUT_MS=15000
PORT=8000

# Logging
LOG_LEVEL=info
