# Onasis AI Service Router Configuration
# 2-Model Setup: Coding + General Purpose

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_PATH=/api/chat

# Primary model for coding tasks
OLLAMA_MODEL=qwen2.5-coder:3b

# Secondary model for tool summarization and quick responses
OLLAMA_TOOL_MODEL=qwen2:1.5b

# ============================================
# Onasis Branded System Prompt
# ============================================
# This prompt gives L0 the Onasis personality
OLLAMA_SYSTEM_PROMPT=You are L0, Onasis's AI coding assistant. Our mission: "Change the world one simple solution at a time." You help users build better code with intelligence, memory, and clarity. When asked about code, analyze thoroughly before suggesting changes. Use memory.search to recall past conversations and stored knowledge - always check memory before making assumptions. Provide practical, working solutions. Be concise but thorough.

# ============================================
# API Endpoints
# ============================================
API_BASE_URL=https://api.lanonasis.com
AUTH_GATEWAY_URL=http://localhost:4000

# Supabase edge fallback endpoint (vendor adapter)
SUPABASE_URL=https://mxtsdgkwzjzlttpotole.supabase.co

# Cloud vendor endpoints (optional overrides)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ============================================
# Memory Service Configuration
# ============================================
MEMORY_PREFETCH_ENABLED=true
MEMORY_PREFETCH_TOPK=5
MEMORY_PREFETCH_MAX_CHARS=2000
MEMORY_SEARCH_PATH=/api/v1/memories/search
MEMORY_GET_PATH=/api/v1/memories
MEMORY_WRITE_PATH=/api/v1/memories
MEMORY_BATCH_GET_PATH=

# ============================================
# Memory Authentication
# ============================================
# Add your Onasis API key here:
MEMORY_AUTH_BEARER=
MEMORY_API_KEY=lano_your_api_key_here

# ============================================
# Tool Configuration (Optimized for 8GB RAM)
# ============================================
TOOL_RESULT_SUMMARIZE=true
TOOL_RESULT_MAX_CHARS=3000
SOFT_TOOL_PARSE=true
RESPONSE_CLEANUP_ENABLED=true
RETURN_ACTIONS_ENVELOPE=false

# ============================================
# Router Settings
# ============================================
ROUTER_TIMEOUT_MS=10000
PORT=8000

# ============================================
# Vendor Credentials (required by adapters)
# ============================================
# Supabase edge adapter (required for fallback vendor)
SUPABASE_ANON_KEY=

# DeepSeek adapter (required only when deepseek vendor is activated)
DEEPSEEK_API_KEY=

# OpenAI adapter (required when OpenAI vendor is active)
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_QUALITY_MODEL=gpt-4o

# Anthropic adapter (required when Anthropic vendor is active)
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
ANTHROPIC_QUALITY_MODEL=claude-3-5-sonnet-latest

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Branding (Optional)
# ============================================
# These can be used by your frontend to display Onasis branding
BRAND_NAME=Onasis
BRAND_TAGLINE=Change the world one simple solution at a time
BRAND_AI_NAME=L0
BRAND_VERSION=1.0.0
